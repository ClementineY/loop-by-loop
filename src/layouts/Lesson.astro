---
import Base from './Base.astro';
import Sidebar from '../components/Sidebar.astro';
import ColabButton from '../components/ColabButton.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/url';
interface Props { title: string; summary: string; slug: string; colab?: string; }
const { title, summary, slug, colab } = Astro.props;
const all = (await getCollection('lessons', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((l) => l.id === slug);
const prev = i > 0 ? all[i - 1] : null;
const next = i >= 0 && i < all.length - 1 ? all[i + 1] : null;
---
<Base title={`${title} · Loop by Loop`} description={summary}>
  <div class="layout">
    <aside class="rail"><div class="rail-label">Course map</div><Sidebar currentSlug={slug} /></aside>
    <article class="article">
      <div class="lesson-meta"><span>Lesson {i + 1} of {all.length}</span><span>{all[i]?.data.duration ?? 10} min</span></div>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <slot />
      {colab && <div class="colab-wrap"><ColabButton notebook={colab} /></div>}
      <nav class="prevnext">
        {prev ? <a href={withBase(`/lessons/${prev.id}`)}>← {prev.data.title}</a> : <span></span>}
        {next ? <a href={withBase(`/lessons/${next.id}`)}>{next.data.title} →</a> : <span></span>}
      </nav>
    </article>
  </div>
</Base>
<style>
  .layout { display:grid; grid-template-columns:230px minmax(0,760px); gap:4.5rem; max-width:1120px;
    margin:0 auto; padding:3rem 1.25rem; }
  .rail { position:sticky; top:5.5rem; align-self:start; max-height:calc(100vh - 7rem); overflow:auto; }
  .rail-label { text-transform:uppercase;letter-spacing:.11em;font:800 .62rem var(--font-mono);color:var(--text-subtle);padding:0 .35rem .7rem; }
  .article { min-width:0; }
  .lesson-meta { display:flex;gap:.8rem;color:var(--text-subtle);text-transform:uppercase;letter-spacing:.08em;font:700 .65rem var(--font-mono); }
  .lesson-meta span+span:before{content:'·';margin-right:.8rem}
  .article h1 { font-size:clamp(2.5rem,6vw,4.5rem);letter-spacing:-.055em;margin:.7rem 0 .8rem; }
  .summary { color:var(--text-muted); font-size:1.16rem;line-height:1.55;margin-bottom:2.6rem; }
  .article :global(h2){font-size:1.6rem;margin-top:3rem;letter-spacing:-.025em}.article :global(h3){margin-top:2rem}.article :global(p),.article :global(li){max-width:68ch}.article :global(img){max-width:100%;border-radius:12px}
  .colab-wrap { margin:2rem 0; }
  .prevnext { display:flex; justify-content:space-between; margin-top:2.5rem;
    border-top:1px solid var(--border); padding-top:1rem; gap:1rem; }
  .prevnext a { text-decoration:none;font-weight:720;font-size:.86rem; }
  @media (max-width:820px){ .layout{ grid-template-columns:1fr;padding-top:2rem; } .rail{ position:static; max-height:none;order:2;border-top:1px solid var(--border);padding-top:1.5rem}.article{order:1} }
</style>
