---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/url';
---
<Base title="Page not found · Loop by Loop" description="This Loop by Loop page could not be found.">
  <section class="missing">
    <p>404 · Shape mismatch</p>
    <h1>This route cannot<br />be broadcast.</h1>
    <p class="explanation">The page may have moved, or its dimensions were never compatible with this course.</p>
    <div><a href={withBase('/')}>Return home</a><a href={withBase('/experiments')}>Browse experiments</a></div>
  </section>
</Base>
<style>
  .missing{max-width:900px;margin:0 auto;padding:8rem 1.25rem;text-align:center}.missing>p:first-child{color:var(--accent);font:800 .72rem var(--font-mono);text-transform:uppercase;letter-spacing:.12em}.missing h1{font-size:clamp(3rem,8vw,6rem);line-height:.94;letter-spacing:-.06em;margin:1rem 0}.explanation{max-width:560px;margin:1.5rem auto;color:var(--text-muted);font-size:1.05rem}.missing div{display:flex;justify-content:center;flex-wrap:wrap;gap:.8rem;margin-top:2rem}.missing a{padding:.7rem .9rem;border:1px solid var(--border);border-radius:9px;background:var(--surface);font-weight:720;text-decoration:none}.missing a:first-child{background:var(--accent);color:white;border-color:var(--accent)}
</style>
